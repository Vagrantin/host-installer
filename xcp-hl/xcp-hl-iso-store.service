[Unit]
Description=Create and reconcile the XCP-HL ISO storage repository
Documentation=https://github.com/Vagrantin/xcp-hl
Requires=xapi.service xapi-init-complete.target
After=xapi.service xapi-init-complete.target storage-init.service local-fs.target

# Deliberately no ConditionPathExists guard: this converges on every boot.
# XAPI does not reliably re-plug this SR's PBD after a restart, so a
# create-once unit would leave the ISO library detached and unusable.

[Service]
Type=oneshot
ExecStart=/opt/xensource/libexec/xcp-hl-iso-sr-init
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
